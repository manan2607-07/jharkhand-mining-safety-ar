# ==============================================================================
# Jharkhand AR Mining Safety Platform - Environment Configuration Template
# SIH 2026 - Problem Statement ID: 26041
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV=production

# Server Port
PORT=5001

# Primary Cryptographic JWT Secret for Token Signing
# Generate a cryptographically secure key: `openssl rand -hex 32`
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production

# Statutory Certificate Digital HMAC Signing Secret
# Logically decoupled from JWT_SECRET for defense-in-depth isolation
CERT_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production

# Allowed CORS Origins (Comma-separated URLs or '*' for development)
ALLOWED_ORIGINS=http://localhost:5176,http://127.0.0.1:5176

# Evaluation credentials directory (set to 'true' only in local review environments)
ENABLE_EVALUATION_CREDENTIALS=false
