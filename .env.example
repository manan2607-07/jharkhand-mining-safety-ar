# ═══════════════════════════════════════════════════════════════════════════════
# Jharkhand AR Mining Safety Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
#   1. Copy this file to `.env`: cp .env.example .env
#   2. Generate secure secrets: openssl rand -hex 32
#   3. Replace the placeholder values below with your generated secrets
#   4. NEVER commit the .env file to version control
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server Configuration ─────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Cryptographic Secrets (REQUIRED — generate with: openssl rand -hex 32) ──
# These secrets are used for JWT signing and certificate HMAC generation.
# They MUST be unique, random, and kept confidential.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
CERT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ── CORS Allowed Origins (comma-separated) ──────────────────────────────────
# In production, list only your exact deployment URLs.
ALLOWED_ORIGINS=http://localhost:5176,http://localhost:5177,https://jharkhand-mining-safety-ar-six.vercel.app,https://jharkhand-mining-admin.vercel.app

# ── Feature Flags ────────────────────────────────────────────────────────────
# Enable evaluation credential endpoint (for SIH demo only — disable in production)
ENABLE_EVALUATION_CREDENTIALS=true
